---
import { Font } from 'astro:assets';
import SEO, { type Breadcrumb } from '../components/seo/SEO.astro';
import type { ImageMetadata } from 'astro';
import type { PageSchema } from '../utils/jsonld';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { t } from '../i18n/utils';
import type { Lang, RouteKey } from '../i18n/routes';
import '../styles/global.css';

export interface Props {
	title: string;
	description: string;
	routeKey: RouteKey;
	lang: Lang;
	schema?: PageSchema;
	breadcrumbs?: Breadcrumb[];
	noindex?: boolean;
	image?: { src: ImageMetadata; alt: string };
	notFound?: boolean;
}

const { title, description, routeKey, lang, schema, breadcrumbs, noindex, image, notFound } =
	Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href="/icon.webp" type="image/webp" sizes="192x192" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<Font cssVariable="--font-roboto" preload />
		<Font cssVariable="--font-roboto-mono" preload />
		<Font cssVariable="--font-mandys" preload />
		<SEO
			title={title}
			description={description}
			routeKey={routeKey}
			lang={lang}
			schema={schema}
			breadcrumbs={breadcrumbs}
			noindex={noindex}
			image={image}
			notFound={notFound}
		/>
	</head>
	<body>
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-base focus:bg-mustard focus:px-4 focus:py-2 focus:text-ink"
		>
			{t(lang, 'a11y.skipToContent')}
		</a>
		<Header lang={lang} routeKey={routeKey} />
		<main id="main-content">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
