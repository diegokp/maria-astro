---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { IS_PRODUCTION, OG_LOCALE, SITE, SITE_NAME, THEME_COLOR } from '../../consts';
import { getAlternates, localizedPath, t, type Alternate } from '../../i18n/utils';
import { LOCALES, type Lang, type RouteKey } from '../../i18n/routes';
import ogDefault from '../../assets/images/og-default.webp';
import portrait from '../../assets/images/maria-about.webp';
import { buildGraph, type PageSchema } from '../../utils/jsonld';

export interface Breadcrumb {
	name: string;
	url: string;
}

export interface Props {
	title: string;
	description: string;
	routeKey: RouteKey;
	lang: Lang;
	/** Tipo de página para el JSON-LD (src/utils/jsonld.ts). Por defecto, WebPage. */
	schema?: PageSchema;
	breadcrumbs?: Breadcrumb[];
	/** Página fuera del índice aunque sea producción (p. ej. el blog «Próximamente»). */
	noindex?: boolean;
	/** Imagen para compartir propia (1200×630). Por defecto, el retrato de María. */
	image?: { src: ImageMetadata; alt: string };
}

const {
	title,
	description,
	routeKey,
	lang,
	schema = { type: 'webpage' },
	breadcrumbs,
	noindex = false,
	image,
} = Astro.props;

// Robots: fuera de producción, nada se indexa ni se sigue (previews de Vercel,
// dev). En producción, solo las páginas marcadas como noindex.
const robots = !IS_PRODUCTION ? 'noindex, nofollow' : noindex ? 'noindex, follow' : null;

// Imagen OG en JPEG (máxima compatibilidad en WhatsApp, LinkedIn, Facebook)
// generada en el build desde el WebP del repo.
const ogSource = image?.src ?? ogDefault;
const ogImage = await getImage({ src: ogSource, format: 'jpg', width: 1200, height: 630 });
const ogImageUrl = new URL(ogImage.src, SITE).toString();
const ogImageAlt = image?.alt ?? t(lang, 'contact.photoAlt');

// Avisos de build: longitudes fuera del objetivo (título ≤ 60, description
// 150–160; en griego cuentan caracteres, no bytes).
if (IS_PRODUCTION && !noindex) {
	const url = localizedPath(routeKey, lang);
	if ([...title].length > 60) console.warn(`[seo] Título de ${[...title].length} car. (> 60) en ${url}`);
	const d = [...description].length;
	if (d < 150 || d > 160) console.warn(`[seo] Description de ${d} car. (objetivo 150–160) en ${url}`);
}

const canonical = new URL(localizedPath(routeKey, lang), SITE).toString();
const alternates: Alternate[] = getAlternates(routeKey);

// JSON-LD: un único @graph por página (src/utils/jsonld.ts).
const abs = (path: string) => new URL(path, SITE).toString();
const personImage = await getImage({ src: portrait, format: 'jpg', width: 800 });
const jsonLd = buildGraph({
	lang,
	url: canonical,
	title,
	description,
	jobTitle: t(lang, 'person.jobTitle'),
	personDescription: t(lang, 'about.seo.description'),
	aboutUrl: abs(localizedPath('about', lang)),
	contactUrl: abs(localizedPath('contact', lang)),
	personImage: abs(personImage.src),
	logo: abs('/images/maria-dimitropoulou-logo.webp'),
	breadcrumbs,
	schema,
});
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta name="theme-color" content={THEME_COLOR} />
{robots && <meta name="robots" content={robots} />}

{
	alternates.map((alt) => (
		<link rel="alternate" hreflang={alt.lang} href={alt.url} />
	))
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={OG_LOCALE[lang]} />
{
	LOCALES.filter((l) => l !== lang).map((l) => (
		<meta property="og:locale:alternate" content={OG_LOCALE[l]} />
	))
}
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
