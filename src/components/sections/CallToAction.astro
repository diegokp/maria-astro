---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import cloud from '../../assets/images/cloud.webp';
import { localizedPath, t } from '../../i18n/utils';
import type { Lang } from '../../i18n/routes';

export interface Props {
	lang: Lang;
	/** Por defecto, los textos genéricos de `cta.*` en ui.ts. */
	heading?: string;
	text?: string;
	button?: string;
	/** Nivel del título según la jerarquía de la página que lo usa. */
	headingAs?: 'h2' | 'h3';
}

const {
	lang,
	heading = t(lang, 'cta.heading'),
	text = t(lang, 'cta.text'),
	button = t(lang, 'cta.button'),
	headingAs: Heading = 'h2',
} = Astro.props;
---

{/* Llamada a la acción reutilizable (home, servicios y, en la fase 4, posts):
    transparente, enmarcada con un borde del color de los títulos y radio 12px,
    con la nube a la izquierda y el botón a Contacto. */}
<section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
	<div
		class="grid items-center gap-6 rounded-base border border-text-heading px-6 py-10 text-center sm:grid-cols-[10rem_1fr] sm:gap-10 sm:px-10 sm:text-left lg:grid-cols-[12rem_1fr] lg:px-14"
	>
		{/* Decorativa: alt vacío. */}
		<Image
			src={cloud}
			alt=""
			widths={[160, 240, 384]}
			sizes="(min-width: 1024px) 192px, 160px"
			class="mx-auto w-32 sm:w-full"
		/>
		<div>
			<Heading class="font-display text-3xl text-text-heading sm:text-4xl">{heading}</Heading>
			<p class="mx-auto mt-3 max-w-xl font-sans text-lg leading-relaxed text-text-soft sm:mx-0">{text}</p>
			<div class="mt-6">
				<Button href={localizedPath('contact', lang)}>
					{button}
				</Button>
			</div>
		</div>
	</div>
</section>
