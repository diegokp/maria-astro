---
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/routes';

export interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 py-4 text-center sm:px-6">
	<p class="font-sans text-base text-text-soft sm:text-lg">{t(lang, 'home.intro.text')}</p>
</section>
