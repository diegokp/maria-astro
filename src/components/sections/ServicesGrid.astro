---
import { getCollection } from 'astro:content';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import { localizedPath, t } from '../../i18n/utils';
import { serviceRouteKey, type Lang } from '../../i18n/routes';

export interface Props {
	lang: Lang;
	/**
	 * `home`: los 3 primeros servicios (por `order`) + botón al índice.
	 * `index`: página /servicios/ — todos, título como h1 y sin botón.
	 */
	variant?: 'home' | 'index';
}

const { lang, variant = 'home' } = Astro.props;
const isIndex = variant === 'index';
const HOME_LIMIT = 3;
const Heading = isIndex ? 'h1' : 'h3';

const services = (await getCollection('services', ({ data }) => data.lang === lang)).sort(
	(a, b) => a.data.order - b.data.order,
);
const shown = isIndex ? services : services.slice(0, HOME_LIMIT);
---

{/* Home: título h3 + 3 tarjetas + botón «todos mis servicios».
    Índice /servicios/: título h1 + todas las tarjetas, sin botón. */}
<section id="services" class="bg-canvas">
	<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<Heading
			class:list={[
				'mx-auto max-w-3xl text-center font-display text-text-heading',
				isIndex ? 'text-4xl sm:text-5xl' : 'text-3xl sm:text-4xl',
			]}
		>
			{t(lang, 'home.services.heading')}
		</Heading>
		{/* Flex centrado: con un número de tarjetas que no llena la última fila
		    (p. ej. 7 = 3 + 3 + 1), la fila incompleta queda centrada. */}
		<ul class="mt-10 flex flex-wrap justify-center gap-6">
			{
				shown.map((service) => (
					<li class="w-full sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)]">
						<Card
							title={service.data.title}
							titleAs={isIndex ? 'h2' : 'h3'}
							href={localizedPath(serviceRouteKey(service.data.serviceKey), lang)}
							image={service.data.image}
						/>
					</li>
				))
			}
		</ul>
		{
			!isIndex && (
				<div class="mt-10 text-center">
					<Button href={localizedPath('services', lang)}>{t(lang, 'home.services.cta')}</Button>
				</div>
			)
		}
	</div>
</section>
