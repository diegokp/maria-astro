---
import { getCollection } from 'astro:content';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import sessionsImage from '../../assets/images/rainbow-psychologos-online.webp';
import coursesImage from '../../assets/images/FormProfesional.webp';
import { localizedPath, t } from '../../i18n/utils';
import {
	SERVICE_GROUPS,
	serviceRouteKey,
	type Lang,
	type ServiceGroup,
	type ServiceKey,
} from '../../i18n/routes';

export interface Props {
	lang: Lang;
	/** Grupo de servicios a listar en el índice: «Sesiones» (por defecto) o «Cursos». */
	group?: ServiceGroup;
	/**
	 * `home`: dos tarjetas (Sesiones y Cursos), cada una con ilustración, título y botón «Ver más» a su índice.
	 * `index`: página índice del grupo — título como h1, una tarjeta por servicio con su descripción corta y sin botón.
	 */
	variant?: 'home' | 'index';
}

const { lang, group = 'sessions', variant = 'home' } = Astro.props;
const isIndex = variant === 'index';

// Ilustración de cada grupo en la home (decorativa).
const groupImages = { sessions: sessionsImage, courses: coursesImage } as const;
const groups = Object.keys(SERVICE_GROUPS) as ServiceGroup[];

const groupKeys: readonly ServiceKey[] = SERVICE_GROUPS[group];
const shown = (
	await getCollection(
		'services',
		({ data }) => data.lang === lang && groupKeys.includes(data.serviceKey),
	)
).sort((a, b) => a.data.order - b.data.order);
---

{
	isIndex ? (
		<section id="services" class="bg-canvas">
			<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
				<h1 class="mx-auto max-w-3xl text-center font-display text-4xl text-text-heading sm:text-5xl">
					{t(lang, `${group}.heading`)}
				</h1>
				{/* Flex centrado: con un número de tarjetas que no llena la última fila
				    (p. ej. 4 = 3 + 1), la fila incompleta queda centrada. */}
				<ul class="mt-10 flex flex-wrap justify-center gap-6">
					{shown.map((service) => (
						<li class="w-full sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)]">
							<Card
								title={service.data.title}
								titleAs="h2"
								href={localizedPath(serviceRouteKey(service.data.serviceKey), lang)}
								description={service.data.description}
								image={service.data.image}
							/>
						</li>
					))}
				</ul>
			</div>
		</section>
	) : (
		<section id="services" class="bg-canvas">
			<div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
				{/* Home: título h3 + una tarjeta por grupo (Sesiones, Cursos) con su botón al índice. */}
				<h3 class="mx-auto max-w-3xl text-center font-display text-3xl text-text-heading sm:text-4xl">
					{t(lang, 'home.services.heading')}
				</h3>
				<ul class="mt-10 grid gap-12 sm:grid-cols-2 sm:gap-8">
					{groups.map((key) => (
						<li class="mx-auto flex w-full max-w-sm flex-col items-center">
							<Card
								title={t(lang, `${key}.heading`)}
								image={groupImages[key]}
								titleAs="h4"
								class="w-full flex-1"
							/>
							<Button href={localizedPath(key, lang)} class="mt-4">
								{t(lang, `${key}.cta`)}
							</Button>
						</li>
					))}
				</ul>
			</div>
		</section>
	)
}
