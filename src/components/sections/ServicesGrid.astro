---
import Card from '../ui/Card.astro';
import { localizedPath, t } from '../../i18n/utils';
import type { Lang, RouteKey } from '../../i18n/routes';
import type { UIKey } from '../../i18n/ui';

export interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const services: { routeKey: RouteKey; titleKey: UIKey; blurbKey: UIKey }[] = [
	{
		routeKey: 'service.psychological',
		titleKey: 'service.psychological.title',
		blurbKey: 'service.psychological.blurb',
	},
	{
		routeKey: 'service.parental',
		titleKey: 'service.parental.title',
		blurbKey: 'service.parental.blurb',
	},
	{
		routeKey: 'service.mindfulness',
		titleKey: 'service.mindfulness.title',
		blurbKey: 'service.mindfulness.blurb',
	},
	{
		routeKey: 'service.training',
		titleKey: 'service.training.title',
		blurbKey: 'service.training.blurb',
	},
];
---

<section id="services" class="bg-surface-alt">
	<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<h2 class="font-display text-3xl text-text">{t(lang, 'home.services.heading')}</h2>
		<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{
				services.map((service) => (
					<Card
						title={t(lang, service.titleKey)}
						description={t(lang, service.blurbKey)}
						href={localizedPath(service.routeKey, lang)}
					/>
				))
			}
		</div>
	</div>
</section>
