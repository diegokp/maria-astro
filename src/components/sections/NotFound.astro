---
import { localizedPath, t } from '../../i18n/utils';
import type { Lang } from '../../i18n/routes';

export interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

// Las secciones principales: quien llega desde una URL antigua del WordPress
// (o un enlace roto) encuentra un camino en vez de un callejón sin salida.
const links = ['home', 'sessions', 'courses', 'about', 'blog', 'contact'] as const;
---

<section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-24">
	<p class="font-mono text-sm text-text-soft">404</p>
	<h1 class="mt-3 font-display text-4xl text-text-heading sm:text-5xl">{t(lang, 'notFound.title')}</h1>
	<p class="mx-auto mt-5 max-w-xl font-sans text-lg leading-relaxed text-text-soft">{t(lang, 'notFound.text')}</p>
	<ul class="mt-10 flex flex-wrap justify-center gap-3">
		{
			links.map((key) => (
				<li>
					<a
						href={localizedPath(key, lang)}
						class="inline-flex rounded-base border border-border px-5 py-2.5 font-sans text-text transition-colors hover:bg-hover"
					>
						{t(lang, `nav.${key}`)}
					</a>
				</li>
			))
		}
	</ul>
</section>
