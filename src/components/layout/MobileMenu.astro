---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t } from '../../i18n/utils';
import type { Lang, RouteKey } from '../../i18n/routes';

export interface Props {
	lang: Lang;
	routeKey: RouteKey;
}

const { lang, routeKey } = Astro.props;
---

<button
	type="button"
	id="mobile-menu-toggle"
	aria-expanded="false"
	aria-controls="mobile-menu-panel"
	class="rounded-base border border-border p-2.5 text-text transition-colors hover:bg-hover lg:hidden"
>
	<span class="sr-only" data-label-open={t(lang, 'nav.mobileMenu.open')} data-label-close={t(lang, 'nav.mobileMenu.close')}>
		{t(lang, 'nav.mobileMenu.open')}
	</span>
	<svg aria-hidden="true" width="24" height="24" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
		<path stroke-linecap="round" d="M3 5h14M3 10h14M3 15h14" />
	</svg>
</button>

<div id="mobile-menu-panel" hidden class="absolute inset-x-0 top-full border-t border-border bg-surface p-4 lg:hidden">
	<slot />
	<div class="mt-4 border-t border-border pt-4">
		<LanguageSwitcher lang={lang} routeKey={routeKey} />
	</div>
</div>

<script>
	const toggle = document.getElementById('mobile-menu-toggle');
	const panel = document.getElementById('mobile-menu-panel');
	const label = toggle?.querySelector<HTMLElement>('[data-label-open]');

	if (toggle && panel && label) {
		toggle.addEventListener('click', () => {
			const isOpen = toggle.getAttribute('aria-expanded') === 'true';
			toggle.setAttribute('aria-expanded', String(!isOpen));
			panel.hidden = isOpen;
			label.textContent = isOpen
				? label.dataset.labelOpen ?? ''
				: label.dataset.labelClose ?? '';
			if (!isOpen) panel.querySelector('a')?.focus();
		});

		panel.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				toggle.setAttribute('aria-expanded', 'false');
				panel.hidden = true;
				toggle.focus();
			}
		});
	}
</script>
