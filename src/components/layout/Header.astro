---
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileMenu from './MobileMenu.astro';
import { localizedPath, t } from '../../i18n/utils';
import type { Lang, RouteKey } from '../../i18n/routes';

export interface Props {
	lang: Lang;
	routeKey: RouteKey;
}

const { lang, routeKey } = Astro.props;

const navItems: { routeKey: RouteKey; label: string }[] = [
	{ routeKey: 'home', label: t(lang, 'nav.home') },
	{ routeKey: 'sessions', label: t(lang, 'nav.sessions') },
	{ routeKey: 'courses', label: t(lang, 'nav.courses') },
	{ routeKey: 'about', label: t(lang, 'nav.about') },
	{ routeKey: 'blog', label: t(lang, 'nav.blog') },
	{ routeKey: 'contact', label: t(lang, 'nav.contact') },
];
---

<header class="relative z-20 bg-canvas">
	<div class="relative mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-5 sm:px-8">
		<a href={localizedPath('home', lang)}>
			<img
				src="/images/maria-dimitropoulou-logo.webp"
				alt="María Dimitropoulou López"
				class="h-24 w-auto sm:h-30.5"
				width="478"
				height="479"
			/>
		</a>

		<nav aria-label={t(lang, 'nav.ariaLabel')} class="hidden lg:block">
			<ul class="flex gap-8 font-sans text-base">
				{
					navItems.map((item) => (
						<li>
							<a
								href={localizedPath(item.routeKey, lang)}
								aria-current={routeKey === item.routeKey ? 'page' : undefined}
								class="-mx-2 rounded-base px-2 py-1 text-text transition-colors hover:bg-hover aria-[current=page]:bg-hover aria-[current=page]:text-text"
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="flex items-center gap-4">
			<div class="hidden lg:block">
				<LanguageSwitcher lang={lang} routeKey={routeKey} />
			</div>
			<MobileMenu lang={lang} routeKey={routeKey}>
				<ul class="flex flex-col gap-5 font-sans text-lg">
					{
						navItems.map((item) => (
							<li>
								<a
									href={localizedPath(item.routeKey, lang)}
									aria-current={routeKey === item.routeKey ? 'page' : undefined}
									class="-mx-2 rounded-base px-2 py-1 text-text transition-colors hover:bg-hover aria-[current=page]:bg-hover aria-[current=page]:text-text"
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</MobileMenu>
		</div>
	</div>
</header>
