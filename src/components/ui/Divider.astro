---
import { Image } from 'astro:assets';
import separator from '../../assets/images/separator.webp';
---

{/* Separador decorativo entre secciones: alt vacío, fuera del árbol de accesibilidad. */}
<div class="mx-auto max-w-4xl px-4 py-6 sm:px-6" aria-hidden="true">
	<Image
		src={separator}
		alt=""
		widths={[320, 480, 640, 837]}
		sizes="(min-width: 896px) 640px, 90vw"
		class="mx-auto w-full max-w-xs sm:max-w-md"
	/>
</div>
