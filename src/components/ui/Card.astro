---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
	title: string;
	description?: string;
	href?: string;
	/** Ilustración sobre el texto. Decorativa: el título ya describe la tarjeta. */
	image?: ImageMetadata;
	/** Nivel del título según la jerarquía de la página (h2 bajo un h1, h3 bajo un h2/h3). */
	titleAs?: 'h2' | 'h3';
	class?: string;
}

const { title, description, href, image, titleAs: Title = 'h3', class: className } = Astro.props;

const Tag = href ? 'a' : 'div';

// Tarjeta transparente: solo imagen + texto. Si es enlace, el fondo menta
// aparece al pasar el ratón (regla de hover de CLAUDE.md).
const base = 'block rounded-base p-4 text-center transition-colors';
---

<Tag href={href} class:list={[base, href && 'hover:bg-hover', className]}>
	{
		image && (
			<Image
				src={image}
				alt=""
				widths={[240, 360, 480, 720]}
				sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
				class="aspect-square w-full object-contain"
			/>
		)
	}
	<Title class="mt-4 font-display text-2xl text-text-heading">{title}</Title>
	{description && <p class="mt-2 font-sans text-sm text-text-soft">{description}</p>}
</Tag>
