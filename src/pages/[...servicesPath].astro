---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesGrid from '../components/sections/ServicesGrid.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import { absoluteUrl, localizedPath, t } from '../i18n/utils';
import { getCollection } from 'astro:content';
import {
	LOCALES,
	SERVICE_GROUPS,
	routes,
	serviceRouteKey,
	type Lang,
	type ServiceGroup,
	type ServiceKey,
} from '../i18n/routes';

// Un índice por grupo de servicios e idioma: «Sesiones» y «Cursos».
export function getStaticPaths() {
	const groups = Object.keys(SERVICE_GROUPS) as ServiceGroup[];
	return groups.flatMap((group) =>
		LOCALES.map((lang) => ({
			params: { servicesPath: routes[group][lang].replace(/^\/|\/$/g, '') },
			props: { lang, group },
		})),
	);
}

interface Props {
	lang: Lang;
	group: ServiceGroup;
}

const { lang, group } = Astro.props;

const breadcrumbs = [
	{ name: t(lang, 'nav.home'), url: absoluteUrl(localizedPath('home', lang)) },
	{ name: t(lang, `nav.${group}`), url: absoluteUrl(localizedPath(group, lang)) },
];

// JSON-LD: CollectionPage + ItemList con los servicios del grupo, en el mismo
// orden que las tarjetas.
const groupKeys: readonly ServiceKey[] = SERVICE_GROUPS[group];
const items = (
	await getCollection(
		'services',
		({ data }) => data.lang === lang && groupKeys.includes(data.serviceKey),
	)
)
	.sort((a, b) => a.data.order - b.data.order)
	.map(({ data }) => ({
		name: data.title,
		url: absoluteUrl(localizedPath(serviceRouteKey(data.serviceKey), lang)),
	}));
---

<BaseLayout
	title={t(lang, `${group}.seo.title`)}
	description={t(lang, `${group}.seo.description`)}
	routeKey={group}
	lang={lang}
	breadcrumbs={breadcrumbs}
	schema={{ type: 'collection', items }}
>
	<ServicesGrid lang={lang} group={group} variant="index" />
	<Testimonials lang={lang} group={group} />
	<CallToAction
		lang={lang}
		heading={t(lang, `cta.${group}.heading`)}
		text={t(lang, `cta.${group}.text`)}
	/>
</BaseLayout>
