---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import { absoluteUrl, localizedPath, t } from '../i18n/utils';
import { routes, serviceGroupOf, serviceRouteKey } from '../i18n/routes';
import { highlightHtml } from '../utils/highlight';

// Una página por entrada de la colección `services` (servicio × idioma).
// La URL sale del mapa de rutas, no del nombre del archivo. Los servicios sin
// grupo (`talks`, aparcado) no generan página.
export async function getStaticPaths() {
	const services = await getCollection(
		'services',
		({ data }) => serviceGroupOf(data.serviceKey) !== undefined,
	);
	return services.map((service) => ({
		params: {
			servicePath: routes[serviceRouteKey(service.data.serviceKey)][service.data.lang].replace(
				/^\/|\/$/g,
				'',
			),
		},
		props: { service },
	}));
}

interface Props {
	service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
const { lang, serviceKey, title, description, metaTitle, metaDescription, cta, image } =
	service.data;
const routeKey = serviceRouteKey(serviceKey);
// getStaticPaths ya descarta los servicios sin grupo.
const group = serviceGroupOf(serviceKey)!;
const { Content } = await render(service);

const breadcrumbs = [
	{ name: t(lang, 'nav.home'), url: absoluteUrl(localizedPath('home', lang)) },
	{ name: t(lang, `nav.${group}`), url: absoluteUrl(localizedPath(group, lang)) },
	{ name: title, url: absoluteUrl(localizedPath(routeKey, lang)) },
];
---

<BaseLayout
	title={metaTitle}
	description={metaDescription}
	routeKey={routeKey}
	lang={lang}
	breadcrumbs={breadcrumbs}
>
	<article class="mx-auto max-w-6xl px-4 pt-12 sm:px-6 sm:pt-16">
		<header class="grid items-center gap-8 sm:grid-cols-[12rem_1fr] sm:gap-10 lg:grid-cols-[16rem_1fr] lg:gap-14">
			<div class="mx-auto w-40 sm:w-full">
				<Image
					src={image}
					alt=""
					widths={[160, 256, 384, 512]}
					sizes="(min-width: 1024px) 256px, (min-width: 640px) 192px, 160px"
					loading="eager"
					class="aspect-square w-full object-contain"
				/>
			</div>
			<div class="text-center sm:text-left">
				<a
					href={localizedPath(group, lang)}
					class="-mx-1 rounded-sm px-1 font-mono text-xs tracking-wide text-text-heading uppercase transition-colors hover:bg-hover"
				>
					{t(lang, `nav.${group}`)}
				</a>
				<h1 class="mt-3 font-display text-4xl text-text-heading sm:text-5xl">{title}</h1>
				<p class="mt-5 max-w-2xl font-sans text-lg leading-relaxed text-text-soft" set:html={highlightHtml(description)} />
				<div class="mt-8">
					<Button href={localizedPath('contact', lang)}>{cta}</Button>
				</div>
			</div>
		</header>

		<div class="prose-content mx-auto mt-16 max-w-3xl border-t border-border pt-14">
			<Content />
		</div>

		{/* Mismo botón que en la cabecera, centrado al final del contenido. */}
		<div class="mt-12 text-center">
			<Button href={localizedPath('contact', lang)}>{cta}</Button>
		</div>
	</article>

	<Testimonials lang={lang} serviceKey={serviceKey} class="mt-16 sm:mt-20" />
	<CallToAction
		lang={lang}
		heading={t(lang, `cta.${group}.heading`)}
		text={t(lang, `cta.${group}.text`)}
	/>
	<div class="-mt-6 pb-20 text-center">
		<Button variant="outline" href={localizedPath(group, lang)}>
			{t(lang, `${group}.cta`)}
		</Button>
	</div>
</BaseLayout>
