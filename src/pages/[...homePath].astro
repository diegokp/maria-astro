---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Intro from '../components/sections/Intro.astro';
import ServicesGrid from '../components/sections/ServicesGrid.astro';
import Divider from '../components/ui/Divider.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import { t } from '../i18n/utils';
import { DEFAULT_LOCALE, LOCALES, type Lang } from '../i18n/routes';

export function getStaticPaths() {
	return LOCALES.map((lang) => ({
		params: { homePath: lang === DEFAULT_LOCALE ? undefined : lang },
		props: { lang },
	}));
}

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
---

<BaseLayout
	title={t(lang, 'home.seo.title')}
	description={t(lang, 'home.seo.description')}
	routeKey="home"
	lang={lang}
	personSchema
>
	<Hero lang={lang} />
	<Intro lang={lang} />
	<ServicesGrid lang={lang} />
	<Divider />
	<Newsletter lang={lang} />
	<CallToAction lang={lang} headingAs="h3" />
</BaseLayout>
