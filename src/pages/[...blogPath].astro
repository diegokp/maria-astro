---
// TEMPORAL: página «próximamente» hasta la fase 4 (blog). Se sustituirá por
// el índice real de posts generado desde la colección `blog`.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import illustration from '../assets/images/blog-coming-soon.webp';
import { absoluteUrl, localizedPath, t } from '../i18n/utils';
import { LOCALES, routes, type Lang } from '../i18n/routes';

export function getStaticPaths() {
	return LOCALES.map((lang) => ({
		params: { blogPath: routes.blog[lang].replace(/^\/|\/$/g, '') },
		props: { lang },
	}));
}

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const breadcrumbs = [
	{ name: t(lang, 'nav.home'), url: absoluteUrl(localizedPath('home', lang)) },
	{ name: t(lang, 'nav.blog'), url: absoluteUrl(localizedPath('blog', lang)) },
];
---

<BaseLayout
	title={t(lang, 'blog.seo.title')}
	description={t(lang, 'blog.seo.description')}
	routeKey="blog"
	lang={lang}
	breadcrumbs={breadcrumbs}
>
	<section class="mx-auto max-w-5xl px-4 py-16 text-center sm:px-6 sm:py-24">
		<p class="font-mono text-xs uppercase tracking-wide text-text-heading">{t(lang, 'nav.blog')}</p>
		<h1 class="mt-3 font-display text-4xl text-text-heading sm:text-5xl lg:text-6xl">
			{t(lang, 'blog.comingSoon')}
		</h1>
		<!-- Decorativa: alt vacío. Recorte horizontal para quitar el margen en
		     blanco de arriba y abajo de la ilustración. -->
		<Image
			src={illustration}
			alt=""
			widths={[360, 640, 960, 1280]}
			sizes="(min-width: 1024px) 976px, 100vw"
			loading="eager"
			class="mt-10 aspect-16/7 w-full object-cover sm:mt-12"
		/>
	</section>
</BaseLayout>
