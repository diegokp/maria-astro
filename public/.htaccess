	RewriteRule ^3403/?$ https://mariadimitropouloulopez.com/nea/ [L,R=301]
	# wp 3302
	RewriteRule ^live-για-μέλη-project-parenting-πώς-να-απελευθερωθώ-από/?$ https://mariadimitropouloulopez.com/nea/ [L,R=301]
	# wp 3307
	RewriteRule ^facebook-live-για-μέλη-project-parenting/?$ https://mariadimitropouloulopez.com/nea/ [L,R=301]
	# wp 3375
	RewriteRule ^βίντεο-σειρά-project-parenting-πώς-να-υποστηρίξω-την/?$ https://mariadimitropouloulopez.com/nea/ [L,R=301]
