	# wp 4152
	RewriteRule ^ομιλία-μείωσε-το-άγχος-σου-ως-γονιός-κα/?$ https://mariadimitropouloulopez.com/nea/ [L,R=301]

	# 1. Un único origen: HTTPS y sin www (igual que el canonical).
	#    Si el hosting termina el SSL en un proxy, %{HTTPS} puede venir "off":
	#    en ese caso, cambiar la primera condición por
	#    RewriteCond %{HTTP:X-Forwarded-Proto} !=https [OR]
	RewriteCond %{HTTPS} !=on [OR]
	RewriteCond %{HTTP_HOST} ^www\. [NC]
	RewriteRule ^ https://mariadimitropouloulopez.com%{REQUEST_URI} [L,R=301,NE]

	# 2. /…/index.html → /…/ (evita contenido duplicado).
	RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
	RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301,NE]

	# 3. Barra final en las rutas sin extensión (trailingSlash: 'always').
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_URI} !/$
	RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{1,5}$
	RewriteRule ^(.*)$ /$1/ [L,R=301,NE]

</IfModule>

# 404 en el idioma de la ruta (código HTTP 404 real; las páginas llevan noindex).
ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/es/#">
	ErrorDocument 404 /es/404/index.html
</If>
<If "%{REQUEST_URI} =~ m#^/en/#">
	ErrorDocument 404 /en/404/index.html
</If>

# Tipos MIME (Search Console necesita el sitemap como XML).
AddType application/xml .xml
AddType text/plain .txt
AddType image/webp .webp
AddType font/woff2 .woff2
AddCharset utf-8 .html .xml .txt .css .js

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
	# Recursos con hash en el nombre (/_astro/): caché de un año, inmutable.
	<If "%{REQUEST_URI} =~ m#^/_astro/#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
	# HTML, robots.txt y sitemap: siempre revalidar, para que los cambios se vean al momento.
	<FilesMatch "\.(html|xml|txt)$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
	# Imágenes sin hash (logo, favicon): una semana.
	<FilesMatch "\.(webp|ico)$">
		Header set Cache-Control "public, max-age=604800"
	</FilesMatch>
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
