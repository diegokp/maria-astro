# mariadimitropouloulopez.com — Apache (Nicalia). Se copia a dist/ en el build.
# Ver docs/DESPLIEGUE.md y docs/REDIRECCIONES-WORDPRESS.md (redirecciones del
# antiguo WordPress, aprobadas el 10/11/2026).

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
	RewriteEngine On

	# 0. Redirecciones 301 del antiguo WordPress (aprobadas el 10/11/2026;
	#    docs/REDIRECCIONES-WORDPRESS.md). Van ANTES de las reglas de HTTPS y
	#    barra final, con destino absoluto, para que cada URL antigua haga un
	#    único 301 (sin cadenas). Apache compara la ruta ya decodificada (UTF-8).
	# --- Páginas
	RewriteRule ^mindful-parenting/?$ https://mariadimitropouloulopez.com/programmata/mindful-parenting/ [L,R=301]
	RewriteRule ^mindfulparentingcourse/?$ https://mariadimitropouloulopez.com/programmata/mindful-parenting/ [L,R=301]
	RewriteRule ^servicios/?$ https://mariadimitropouloulopez.com/es/sesiones/ [L,R=301]
	RewriteRule ^υπηρεσίες/?$ https://mariadimitropouloulopez.com/synedries/ [L,R=301]
	RewriteRule ^συμβουλευτική-γονέων/?$ https://mariadimitropouloulopez.com/synedries/goneiki-oikogeneiaki-therapeia/ [L,R=301]
	RewriteRule ^eπιμόρφωση-επαγγελματιών/?$ https://mariadimitropouloulopez.com/programmata/ [L,R=301]
	RewriteRule ^mindfulness/?$ https://mariadimitropouloulopez.com/synedries/psychotherapeftiki-ypostirixi/ [L,R=301]
	RewriteRule ^τελευταία-νέα/?$ https://mariadimitropouloulopez.com/nea/ [L,R=301]
	# --- Archivo y rutas de WordPress
	RewriteRule ^(category|tag)/ https://mariadimitropouloulopez.com/nea/ [L,R=301]
	RewriteRule ^(comments/)?feed/?$ https://mariadimitropouloulopez.com/nea/ [L,R=301]
	RewriteRule ^(wp-admin|wp-content|wp-includes)/ - [G]
	RewriteRule ^(wp-login\.php|xmlrpc\.php)$ - [G]
	# --- Posts (49): al blog griego hasta que María los republique. Al
	#     republicar uno, cambiar su destino por la URL nueva del post.
	# wp 1502
	RewriteRule ^εκπαιδευτικοί-σε-καραντίνα-live-facebook-qa/?$ https://mariadimitropouloulopez.com/nea/ [L,R=301]
	# wp 1563
	RewriteRule ^διαδικτυακή-συνάντηση-με-τους-γονείς/?$ https://mariadimitropouloulopez.com/nea/ [L,R=301]
